# Copy this file to .env and add your own key.
GROQ_API_KEY=
# Set to a model ID currently available to your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
# Optional: default repository shown in the dashboard.
REPOSITORY_ROOT=./sample_data/demo_repository
ARTIFACTS_DIR=./artifacts
TEST_TIMEOUT_SECONDS=120
MAX_TEST_OUTPUT_CHARS=12000
